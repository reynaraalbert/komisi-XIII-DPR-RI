# Konfigurasi Koneksi Supabase PostgreSQL
# Dapatkan DATABASE_URL dan DIRECT_URL dari Dashboard Supabase Anda:
# Project Settings -> Database -> Connection string -> URI / Direct connection

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgboiler=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

